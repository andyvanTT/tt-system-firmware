#
# Optionally compile a custom ERISC (Ethernet RISC) firmware from an external
# source tree and swap it in for the stock prebuilt blob.
#
# Controlled by these sysbuild options (see app/smc/Kconfig.sysbuild):
#   SB_CONFIG_CUSTOM_ERISC_DIR              - source tree; empty => use stock blob
#   SB_CONFIG_CUSTOM_ERISC_TOOLCHAIN_PREFIX - RISCV_TOOLS_PREFIX for the build
#   SB_CONFIG_CUSTOM_ERISC_ARCH            - ARCH (march/mabi) for the build
#   SB_CONFIG_CUSTOM_ERISC_VERSION         - major.minor.patch stamped into fw
#
# Runs at configure time so the swapped blob is on disk before generate_bootfs
# reads --blobs-dir. Stock blobs are preserved under zephyr/blobs/erisc/default
# and compiled blobs are staged under zephyr/blobs/erisc/custom; the selected
# pair is then copied over the active zephyr/blobs/tt_blackhole_erisc*.bin.

set(_erisc_blobs_dir   ${APP_DIR}/../../zephyr/blobs)
set(_erisc_default_dir ${_erisc_blobs_dir}/erisc/default)
set(_erisc_custom_dir  ${_erisc_blobs_dir}/erisc/custom)
set(_erisc_active_fw     ${_erisc_blobs_dir}/tt_blackhole_erisc.bin)
set(_erisc_active_params ${_erisc_blobs_dir}/tt_blackhole_erisc_params.bin)

# --- 1. Preserve the pristine stock blobs as the fallback (seed once) ---------
file(MAKE_DIRECTORY ${_erisc_default_dir})
if(NOT EXISTS ${_erisc_default_dir}/tt_blackhole_erisc.bin)
  configure_file(${_erisc_active_fw} ${_erisc_default_dir}/tt_blackhole_erisc.bin COPYONLY)
endif()
if(NOT EXISTS ${_erisc_default_dir}/tt_blackhole_erisc_params.bin)
  configure_file(${_erisc_active_params} ${_erisc_default_dir}/tt_blackhole_erisc_params.bin COPYONLY)
endif()

if(NOT "${SB_CONFIG_CUSTOM_ERISC_DIR}" STREQUAL "")
  # --- 2. Build the custom ERISC firmware -------------------------------------
  set(_erisc_src ${SB_CONFIG_CUSTOM_ERISC_DIR})
  set(_erisc_eth_init_dir ${_erisc_src}/src/erisc/eth_init)

  if(NOT EXISTS ${_erisc_eth_init_dir}/Makefile)
    message(FATAL_ERROR
      "SB_CONFIG_CUSTOM_ERISC_DIR='${_erisc_src}' does not look like an ERISC source "
      "tree (missing src/erisc/eth_init/Makefile).")
  endif()
  if(NOT EXISTS ${_erisc_src}/src/hardware-definitions/bh/a0/common.mk)
    message(FATAL_ERROR
      "ERISC build system missing at ${_erisc_src}/src/hardware-definitions/ "
      "(no bh/a0/common.mk). Check out the tt-hardware-definitions submodule there.")
  endif()

  # Stamp the requested version into eth_version.h (idempotent).
  string(REPLACE "." ";" _erisc_ver "${SB_CONFIG_CUSTOM_ERISC_VERSION}")
  list(LENGTH _erisc_ver _erisc_ver_len)
  if(NOT _erisc_ver_len EQUAL 3)
    message(FATAL_ERROR
      "SB_CONFIG_CUSTOM_ERISC_VERSION must be major.minor.patch, got "
      "'${SB_CONFIG_CUSTOM_ERISC_VERSION}'.")
  endif()
  list(GET _erisc_ver 0 _erisc_ver_major)
  list(GET _erisc_ver 1 _erisc_ver_minor)
  list(GET _erisc_ver 2 _erisc_ver_patch)

  set(_erisc_version_h ${_erisc_src}/src/common/api/eth_version.h)
  if(NOT EXISTS ${_erisc_version_h})
    message(FATAL_ERROR "ERISC version header not found at ${_erisc_version_h}.")
  endif()
  file(READ ${_erisc_version_h} _erisc_vh)
  string(REGEX REPLACE "#define[ \t]+ETH_INIT_VERSION_MAJOR[ \t]+[0-9]+"
    "#define ETH_INIT_VERSION_MAJOR  ${_erisc_ver_major}" _erisc_vh "${_erisc_vh}")
  string(REGEX REPLACE "#define[ \t]+ETH_INIT_VERSION_MINOR[ \t]+[0-9]+"
    "#define ETH_INIT_VERSION_MINOR  ${_erisc_ver_minor}" _erisc_vh "${_erisc_vh}")
  string(REGEX REPLACE "#define[ \t]+ETH_INIT_VERSION_PATCH[ \t]+[0-9]+"
    "#define ETH_INIT_VERSION_PATCH  ${_erisc_ver_patch}" _erisc_vh "${_erisc_vh}")
  file(WRITE ${_erisc_version_h} "${_erisc_vh}")

  set(_erisc_make_env
    ROOT=${_erisc_src}
    RISCV_TOOLS_PREFIX=${SB_CONFIG_CUSTOM_ERISC_TOOLCHAIN_PREFIX})

  message(STATUS
    "Building custom ERISC firmware from ${_erisc_src} "
    "(version ${SB_CONFIG_CUSTOM_ERISC_VERSION})")

  # Generate autogenerated headers + eth_params.bin.
  execute_process(
    COMMAND make generate_headers ${_erisc_make_env}
    WORKING_DIRECTORY ${_erisc_eth_init_dir}
    RESULT_VARIABLE _erisc_hdr_rc)
  if(NOT _erisc_hdr_rc EQUAL 0)
    message(FATAL_ERROR "ERISC 'make generate_headers' failed (exit ${_erisc_hdr_rc}).")
  endif()

  # Build the mission-mode firmware (plain eth_init variant only).
  execute_process(
    COMMAND make -f Makefile.eth_init --always-make ${_erisc_make_env}
      ARCH=${SB_CONFIG_CUSTOM_ERISC_ARCH}
    WORKING_DIRECTORY ${_erisc_eth_init_dir}
    RESULT_VARIABLE _erisc_fw_rc)
  if(NOT _erisc_fw_rc EQUAL 0)
    message(FATAL_ERROR "ERISC firmware build failed (exit ${_erisc_fw_rc}).")
  endif()

  set(_erisc_out_fw     ${_erisc_src}/out/eth_init.bin)
  set(_erisc_out_params ${_erisc_src}/out/eth_params.bin)
  if(NOT EXISTS ${_erisc_out_fw} OR NOT EXISTS ${_erisc_out_params})
    message(FATAL_ERROR
      "ERISC build did not produce expected outputs "
      "(${_erisc_out_fw}, ${_erisc_out_params}).")
  endif()

  # Stage the compiled blobs.
  file(MAKE_DIRECTORY ${_erisc_custom_dir})
  configure_file(${_erisc_out_fw}     ${_erisc_custom_dir}/tt_blackhole_erisc.bin        COPYONLY)
  configure_file(${_erisc_out_params} ${_erisc_custom_dir}/tt_blackhole_erisc_params.bin COPYONLY)

  set(_erisc_selected_dir ${_erisc_custom_dir})
  message(STATUS "Using CUSTOM ERISC firmware (version ${SB_CONFIG_CUSTOM_ERISC_VERSION}).")
else()
  set(_erisc_selected_dir ${_erisc_default_dir})
  message(STATUS "Using stock ERISC firmware blob (SB_CONFIG_CUSTOM_ERISC_DIR not set).")
endif()

# --- 3. Copy the selected pair over the active blob locations -----------------
configure_file(${_erisc_selected_dir}/tt_blackhole_erisc.bin        ${_erisc_active_fw}     COPYONLY)
configure_file(${_erisc_selected_dir}/tt_blackhole_erisc_params.bin ${_erisc_active_params} COPYONLY)
